name = "ask-nazmul"
main = "ask-nazmul.js"
compatibility_date = "2026-10-01"

[vars]
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL = "gpt-4o-mini"
ALLOWED_ORIGIN = "https://nazmulislam-lab.github.io"
# Set the secret out of band: npx wrangler secret put LLM_API_KEY
# The worker also allows http://localhost and http://127.0.0.1 for local preview.
# Each IP is limited to 10 questions per minute inside a worker isolate.
